# --- Serveur ---
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- PocketBase (compte superutilisateur créé avec : ./bin/pocketbase superuser upsert EMAIL MOT_DE_PASSE) ---
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# --- Première installation ---
# Jeton exigé par l'assistant d'installation pour créer l'administrateur de la plateforme.
# OBLIGATOIRE en production (16 caractères minimum). Générer : openssl rand -hex 16
SETUP_TOKEN=

# --- Emails (codes de réinitialisation du mot de passe) — facultatif ---
# Sans messagerie, l'administrateur réinitialise les mots de passe depuis « Utilisateurs ».
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Divers ---
# Capacité d'accueil de repli (0 = non suivie ; se règle normalement dans la console plateforme)
VENUE_CAPACITY=0
# Base de prévision des encaissements mensuels (0 = moyenne réelle des 3 derniers mois)
FORECAST_MONTHLY_INFLOW=0
