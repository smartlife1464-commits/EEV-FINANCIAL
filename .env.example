# Variables du déploiement Docker (docker/docker-compose.yml)
# Copier en .env à la racine puis : cd docker && docker compose --env-file ../.env up -d --build

# Clé de chiffrement PocketBase : exactement 32 caractères (openssl rand -hex 16)
POCKETBASE_ENCRYPTION_KEY=

# Superutilisateur PocketBase utilisé par l'API (à créer, voir docs/DEPLOIEMENT-PRODUCTION.md)
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# Jeton de l'assistant de première installation (16 caractères minimum)
SETUP_TOKEN=

# Domaine public de l'application (ex. https://gestion.mon-eglise.org)
CORS_ORIGIN=http://localhost

# Emails sortants (facultatif)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
