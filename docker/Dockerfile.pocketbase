# PocketBase autonome : binaire figé (0.25.9, identique au développement) + migrations embarquées.
# Le superutilisateur utilisé par l'API est créé / mis à jour à chaque démarrage depuis l'environnement.
FROM alpine:3.20
ARG PB_VERSION=0.25.9
ARG TARGETARCH
RUN apk add --no-cache ca-certificates unzip wget \
 && ARCH="${TARGETARCH:-amd64}" \
 && wget -q "https://github.com/pocketbase/pocketbase/releases/download/v${PB_VERSION}/pocketbase_${PB_VERSION}_linux_${ARCH}.zip" -O /tmp/pb.zip \
 && unzip /tmp/pb.zip pocketbase -d /usr/local/bin \
 && rm /tmp/pb.zip \
 && mkdir -p /pb_data /pb_hooks
COPY pocketbase/pb_migrations /pb_migrations
COPY docker/pocketbase-entrypoint.sh /usr/local/bin/pocketbase-entrypoint.sh
RUN chmod +x /usr/local/bin/pocketbase-entrypoint.sh
EXPOSE 8090
HEALTHCHECK --interval=10s --timeout=5s --retries=10 CMD wget -qO- http://127.0.0.1:8090/api/health || exit 1
ENTRYPOINT ["/usr/local/bin/pocketbase-entrypoint.sh"]
